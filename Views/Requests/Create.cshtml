@model WebApplication8.Models.RepairRequest

@{
    ViewBag.Title = "Новая заявка";
}

<h2>Новая заявка на ремонт</h2>

@using (Html.BeginForm("Create", "Requests", FormMethod.Post))
{
    <div class="form-group">
        <label>ФИО клиента</label>
        @Html.TextBoxFor(m => m.ClientName, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Устройство</label>
        @Html.TextBoxFor(m => m.Device, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Описание проблемы</label>
        @Html.TextAreaFor(m => m.Problem, new { @class = "form-control", rows = 5 })
    </div>

    <p>
        <input type="submit" value="Создать" class="btn btn-primary" />
        @Html.ActionLink("Отмена", "Index", null, new { @class = "btn btn-default" })
    </p>
}